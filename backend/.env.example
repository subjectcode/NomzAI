PROJECT_NAME="Nomz API"
VERSION="0.1.0"
API_V1_PREFIX="/api"
DATABASE_URL="sqlite:///./nomz.db"
CORS_ORIGINS="*"
ENVIRONMENT="development"

# Multimodal AI Configuration for Ingredient Vision (Milestone 1)
GEMINI_API_KEY=""
