# Nomz Frontend Environment Variables
# Base URL for Nomz FastAPI backend
# Options:
# - Web / Local: http://localhost:8000
# - Android Emulator: http://10.0.2.2:8000
# - Physical Mobile Device (Expo Go): http://<YOUR_LAN_IP>:8000 (e.g. http://192.168.1.50:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Fix for Expo SDK 57 / React Native 0.86 FormData multipart upload in Expo Go
EXPO_PUBLIC_USE_RN_FETCH=1
