# ==========================================
# Nomz Project Environment Variables Template
# ==========================================

# --- Backend Configuration ---
# Port and host for FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# SQLite Database connection URL
DATABASE_URL=sqlite:///./nomz.db

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=*

# Environment: development / staging / production
ENVIRONMENT=development

# Multimodal AI Configuration for Ingredient Vision (Milestone 1)
GEMINI_API_KEY=""
VISION_MODEL="gemini-3.8-flash"
MAX_IMAGE_SIZE_MB=10

# Langflow Workflow Configuration (Milestone 3)
LANGFLOW_BASE_URL="http://localhost:7860"
LANGFLOW_FLOW_ID="2e514b81-21d7-49b9-9fae-a981f95a8029"
LANGFLOW_API_KEY=""
LANGFLOW_TIMEOUT_SECONDS=60.0

# --- Frontend Configuration ---
# API base URL accessed by the React Native / Expo application
# Use localhost for Web/iOS Simulator, 10.0.2.2 for Android Emulator, or your LAN IP for physical device
EXPO_PUBLIC_API_URL=http://localhost:8000
